# Optional. If unset, StudyPilot uses backend/data/studypilot.db.
# This relative example assumes the backend is started from the backend directory.
STUDYPILOT_DATABASE_URL=sqlite:///./data/studypilot.db

# Required only when POST /api/documents/{id}/embedding is called.
DASHSCOPE_API_KEY=

# Optional. Defaults shown below target DashScope China (Beijing).
DASHSCOPE_EMBEDDING_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
STUDYPILOT_EMBEDDING_MODEL=text-embedding-v4

# Optional. If unset, StudyPilot uses backend/data/chroma.
# This relative example assumes the backend is started from the backend directory.
STUDYPILOT_CHROMA_PATH=./data/chroma
